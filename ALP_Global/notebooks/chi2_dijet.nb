  FormBox[
   SuperscriptBox["\[Chi]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a57d76b3-e26a-4ecb-a26f-891b0c81144c"],
 " with and without correlations into one plot"
}], "Subsection",
