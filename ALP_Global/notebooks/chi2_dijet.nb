  3.9687440935129557`*^9}},ExpressionUUID->"d444a000-2398-4e94-b598-\
bb35ed5b01e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chi2ggInd", "[", "cg_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"datagg", "[", 
