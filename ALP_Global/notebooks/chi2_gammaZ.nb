Cell[TextData[{
 "Plot the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Chi]", "2"], TraditionalForm]],ExpressionUUID->
  "3dbcb207-4a29-4f37-8255-44e495c12c9d"],
 " per bin minus the averaged ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Chi]", "2"], TraditionalForm]],ExpressionUUID->
  "40d375f2-fea4-4da1-bf3f-7364b3762454"],
 "per bin (i.e. ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Chi]", "2"], TraditionalForm]],ExpressionUUID->
  "80ef29f8-7e47-470f-8195-634101f29e32"],
 "/number of bins) and normalise by the total ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Chi]", "^", "2"}], "-", 
    SubscriptBox[
     SuperscriptBox["\[Chi]", "2"], "min"]}], TraditionalForm]],
  ExpressionUUID->"f7518bb6-3737-46ef-a96b-9f48d6ac61b1"],
 ":"
}], "Text",
